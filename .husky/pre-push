#!/usr/bin/env sh
# Husky pre-push hook — Scanipy v3.2
#
# Two responsibilities:
#
#  1. Refuse direct pushes (and deletes) to protected branches. GitHub
#     Free + private repos cannot enforce branch protection server-side
#     (see README §"Branch protection"), so this hook + the
#     enforce-pr-only-merges.yml workflow are the process-level shims
#     standing in for real protection.
#
#  2. Run the same fast checks as the CI lint + unit-tests jobs locally
#     so a red push doesn't reach `origin`. Pays for itself the first
#     time you would have shipped a red main and re-based every open
#     branch against the breakage.
#
# Skip both in emergencies with:
#
#     git push --no-verify
#
# Scope choice for the local checks: ruff + ruff format + mypy + pytest
# unit only. We explicitly DO NOT run:
#   - Integration tests (need Postgres up; see docker-compose.dev.yml)
#   - Falsifier campaigns (slow; gated on schedule + release tags)
#   - Attestor canary (slow; gated on detector/engine/env changes)
# Those are CI's job.
set -e

# Honour `--no-verify` semantically: husky already short-circuits the
# hook entirely in that case, but be defensive against direct script
# invocation.
if [ -n "$SKIP_HUSKY" ] || [ "$HUSKY" = "0" ]; then
  echo "pre-push: skipped (SKIP_HUSKY / HUSKY=0 set)"
  exit 0
fi

# ─── Protected-branch guard ────────────────────────────────────────
# Git's pre-push hook receives one line per ref being pushed on stdin:
#     <local ref> <local sha> <remote ref> <remote sha>
# Refuse if any of those refs targets a protected branch on origin.
PROTECTED_BRANCHES="main production release"
ZERO="0000000000000000000000000000000000000000"

while IFS=' ' read -r _local_ref _local_sha remote_ref remote_sha; do
  # When stdin yields no input (manual invocation / test harness), skip
  # the guard rather than block. The remote_ref check below also handles
  # the empty case as a no-op.
  [ -z "$remote_ref" ] && continue
  remote_branch="${remote_ref#refs/heads/}"
  for branch in $PROTECTED_BRANCHES; do
    if [ "$remote_branch" = "$branch" ]; then
      # Block both creates/updates (local_sha != 0) AND deletes
      # (local_sha == 0). Anything that mutates the protected branch
      # is refused.
      echo ""                                                          >&2
      echo "ERROR: direct push to protected branch '$branch' refused." >&2
      echo "       Open a PR via the GitHub UI instead."               >&2
      echo "       Bypass with --no-verify only in real emergencies;"  >&2
      echo "       direct pushes surface as a red 'enforce-pr-only-"   >&2
      echo "       merges' check on the commit (see workflow file)."   >&2
      echo ""                                                          >&2
      # Suppress the unused-var warning for remote_sha (kept named for
      # readability against the git pre-push hook spec).
      : "$remote_sha"
      exit 1
    fi
  done
done

echo "pre-push [1/4]: ruff check"
ruff check .

echo "pre-push [2/4]: ruff format --check"
ruff format --check .

echo "pre-push [3/4]: mypy --strict"
# Mirror the scaffold-phase guard from .github/workflows/ci.yml: if
# there's no Python source yet, mypy has nothing to check and would
# error otherwise.
if find analysis detectors integrations services workers -name "*.py" 2>/dev/null | grep -q .; then
  mypy --config-file pyproject.toml analysis/ detectors/ integrations/ services/ workers/ 2>/dev/null || \
    mypy --config-file pyproject.toml $(find analysis detectors integrations services workers -name "*.py" 2>/dev/null | head -n 1 | xargs -n1 dirname | sort -u | tr '\n' ' ')
else
  echo "  no Python source yet — mypy skipped (scaffold phase)"
fi

echo "pre-push [4/4]: pytest -m unit -x"
# `-x` stops at the first failure for fast feedback. `-q --tb=short`
# matches the CI invocation. We exclude the falsifier + integration
# markers explicitly to avoid pulling them in via marker overlap.
pytest tests/ -m "unit and not integration and not falsifier and not empirical" -q --tb=short -x

echo "pre-push: all checks passed"
