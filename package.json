{
  "name": "scanipy",
  "version": "3.2.0",
  "description": "Multi-tenant SaaS SAST platform — web dashboard and frontend tooling",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint": "eslint web/ --ext .ts,.tsx,.js,.jsx --max-warnings 0",
    "lint:fix": "eslint web/ --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write 'web/**/*.{ts,tsx,js,jsx,css,json}'",
    "format:check": "prettier --check 'web/**/*.{ts,tsx,js,jsx,css,json}'",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0"
  },
  "lint-staged": {
    "web/**/*.{ts,tsx,js,jsx}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "web/**/*.{css,json}": [
      "prettier --write"
    ],
    "*.{yaml,yml}": [
      "yamllint -c .yamllint.yaml"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "scope-case": [2, "always", "lower-case"],
      "subject-case": [2, "always", "sentence-case"],
      "body-max-line-length": [1, "always", 120],
      "footer-max-line-length": [1, "always", 120]
    }
  }
}
