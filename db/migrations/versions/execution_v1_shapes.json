{
  "accepted-content": {
    "detector_sha256s": {
      "$array": "digest"
    },
    "rule_sha256s": {
      "$array": "digest"
    },
    "schema": {
      "$enum": [
        "scanipy-execution/accepted-content/1"
      ]
    },
    "spec_sha256": "digest"
  },
  "attempt-policy": {
    "assignment_id": "nonempty",
    "code_policy_digest": "digest",
    "environment_policy_digest": "digest",
    "lease_seconds": "int:1:900",
    "schema": {
      "$enum": [
        "scanipy-execution/attempt-policy/1"
      ]
    }
  },
  "attempt-result": {
    "actual_code_digest": {
      "$nullable": "digest"
    },
    "actual_env_digest": {
      "$nullable": "env"
    },
    "completed_run_ids": {
      "$array": "uuid"
    },
    "error": {
      "$nullable": {
        "code": "nonempty",
        "message": "text"
      }
    },
    "identity": {
      "$nullable": {
        "cpg_order": {
          "annotation": {
            "$enum": [
              "canonical iff fingerprint_class = strong"
            ]
          },
          "digest": {
            "$nullable": "digest"
          },
          "fingerprint_class": {
            "$nullable": {
              "$enum": [
                "strong",
                "weak"
              ]
            }
          },
          "namespace": {
            "$nullable": "nonempty"
          },
          "status": {
            "$enum": [
              "completed",
              "pending",
              "running",
              "failed",
              "not-applicable"
            ]
          }
        },
        "schema_version": {
          "$enum": [
            2
          ]
        },
        "slice": {
          "annotation": {
            "$enum": [
              "canonical iff fingerprint_class = strong"
            ]
          },
          "digest": {
            "$nullable": "digest"
          },
          "fingerprint_class": {
            "$nullable": {
              "$enum": [
                "strong",
                "weak"
              ]
            }
          },
          "namespace": {
            "$nullable": "nonempty"
          },
          "status": {
            "$enum": [
              "completed",
              "pending",
              "running",
              "failed",
              "not-applicable"
            ]
          }
        }
      }
    },
    "identity_policy_reason": {
      "$nullable": "nonempty"
    },
    "retryable": "bool",
    "schema": {
      "$enum": [
        "scanipy-execution/attempt-result/1"
      ]
    },
    "status": {
      "$enum": [
        "completed",
        "failed"
      ]
    }
  },
  "cancellation": {
    "reason": "nonempty",
    "request_id": "uuid",
    "schema": {
      "$enum": [
        "scanipy-execution/cancellation/1"
      ]
    }
  },
