{
  "schema": "cpg-fidelity/pdg/v1",
  "program_id": "0010-recent-language",
  "method": "Intraprocedural PDG (data + control) by-inspection. instanceof pattern binds c/cash/w guarded by the respective predicate.",
  "methods": [
    {"method": "corpus.cpg.p0010.Payments.settle(Payment)", "dependences": [
      {"from": "param p", "to": "if (p instanceof Card c)", "type": "data", "var": "p"},
      {"from": "if (p instanceof Card c)", "to": "return \"card:\" + c.number()", "type": "control"},
      {"from": "else if (p instanceof Cash cash)", "to": "return \"cash:\" + cash.amount()", "type": "control"},
      {"from": "else if (p instanceof Wire w)", "to": "return \"wire:\" + w.iban()", "type": "control"}
    ]},
    {"method": "corpus.cpg.p0010.Payments.main(String[])", "dependences": [
      {"from": "Payment p = new Card(\"4111\", 9.99)", "to": "System.out.println(settle(p))", "type": "data", "var": "p"}
    ]}
  ]
}
